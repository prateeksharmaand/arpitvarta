# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=arpitvarta_db
DB_USER=arpitvarta_user
DB_PASSWORD=change_me

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=replace_with_random_64_char_string
JWT_EXPIRES_IN=30d

# ── URLs ──────────────────────────────────────────────────
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5174
CORS_ORIGIN=*

# ── Razorpay (same account as GrahVarta) ──────────────────
# Leave blank locally to use demo payments (wallet credits instantly).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ACCOUNT_NUMBER=

# ── Agora (voice/video, same project as GrahVarta) ────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ── Gemini AI (same key as GrahVarta) ─────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
AI_FREE_DAILY_LIMIT=5

# ── Firebase Admin (FCM push) — new ArpitVarta Firebase project ──
# Paste the service account JSON as a single line. Optional locally.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PROFESSIONAL=

# ── SMTP (welcome emails). Blank = print to console ───────
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ArpitVarta <support@arpitvarta.com>"

# ── Upload storage ────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
